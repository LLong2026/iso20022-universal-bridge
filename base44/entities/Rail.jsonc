{
  "name": "Rail",
  "type": "object",
  "properties": {
    "rail_id": {
      "type": "string",
      "description": "Unique rail identifier"
    },
    "name": {
      "type": "string",
      "description": "Display name of the settlement rail"
    },
    "description": {
      "type": "string"
    },
    "cost": {
      "type": "number",
      "description": "Relative transaction cost (lower is better)"
    },
    "speed": {
      "type": "number",
      "description": "Throughput / settlement speed (higher is better)"
    },
    "liquidity": {
      "type": "number",
      "description": "Liquidity depth 0-100 (higher is better)"
    },
    "compliance": {
      "type": "number",
      "description": "Compliance score 0-100 (higher is better)"
    },
    "finality": {
      "type": "number",
      "description": "Settlement finality 0-100 (higher is better)"
    },
    "lifecycle_handler": {
      "type": "string",
      "description": "Identifier of the rail-specific lifecycle handler"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "supported_currencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Currencies this rail can settle"
    },
    "min_amount": {
      "type": "number",
      "description": "Minimum settlement amount"
    },
    "max_amount": {
      "type": "number",
      "description": "Maximum settlement amount"
    },
    "regulatory_tier": {
      "type": "number",
      "description": "Highest counterparty tier cleared: 1=retail, 2=treasury, 3=central_bank"
    }
  },
  "required": [
    "rail_id",
    "name"
  ]
}