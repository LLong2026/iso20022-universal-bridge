{
  "name": "AssetRecord",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "Unique RWA asset identifier"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "gold_bar",
        "coin",
        "bullion",
        "certificate",
        "deed",
        "bond",
        "commodity",
        "digital_asset",
        "other"
      ],
      "description": "Type of asset"
    },
    "weight": {
      "type": "number",
      "description": "Weight in grams"
    },
    "purity": {
      "type": "string",
      "description": "Purity e.g. 999.9"
    },
    "owner_did": {
      "type": "string",
      "description": "DID of the asset owner"
    },
    "satoshi_anchor": {
      "type": "string",
      "description": "Satoshi UTXO this asset is anchored to"
    },
    "description": {
      "type": "string"
    },
    "vault_location": {
      "type": "string"
    },
    "is_encrypted": {
      "type": "boolean",
      "default": false
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "in_vault",
        "in_transit",
        "transferred",
        "retired"
      ],
      "default": "in_vault"
    },
    "file_url": {
      "type": "string",
      "description": "Supporting document URL"
    },
    "file_name": {
      "type": "string",
      "description": "Original filename of the blueprint/document"
    },
    "blueprint_hash": {
      "type": "string",
      "description": "32-byte SHA-256 hash of the blueprint document \u2014 cryptographic intent anchor"
    },
    "encrypted_package": {
      "type": "object",
      "description": "Jasper AES-256-GCM encrypted package (ciphertext, wrapped key, IVs)"
    }
  },
  "required": [
    "asset_id",
    "asset_type",
    "owner_did"
  ]
}