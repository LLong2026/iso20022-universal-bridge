{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "log_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "user_did": {
      "type": "string"
    },
    "before_state": {
      "type": "object"
    },
    "after_state": {
      "type": "object"
    },
    "transaction_id": {
      "type": "string"
    },
    "log_hash": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    }
  },
  "required": [
    "log_id",
    "action"
  ]
}